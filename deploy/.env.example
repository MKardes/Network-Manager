# Copy to .env and adjust. NEVER commit the real .env.
# No application secrets are stored here — the master passphrase is entered at
# runtime via the UI and is never persisted.

# Interface the web UI is published on. MUST be loopback or the WireGuard
# address only (FR-022). Do NOT set to 0.0.0.0.
BIND_ADDR=127.0.0.1

# Published web (nginx) port on the host.
WEB_PORT=8443

# Backend session cookie name (optional).
SESSION_COOKIE=wgnm_sid

# Set to "1" ONLY if you deliberately accept a non-private bind (discouraged;
# the backend refuses a public bind otherwise). See deploy/README.md.
ALLOW_PUBLIC_BIND=0

# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
